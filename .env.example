# MINIMICAL DROP
# Never commit real secrets. Keep production values in Vercel Environment Variables.
NEXT_PUBLIC_APP_URL=https://drop.minimical.online
NEXT_PUBLIC_APP_NAME=MINIMICAL DROP

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://drop.minimical.online/api/google/callback
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# Supabase / Postgres-backed metadata
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin authentication
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD may be used instead for a server-only plaintext password.
SESSION_SECRET=

# Root Drive folder used when creating project folders. Store only the ID, never credentials.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Vercel Cron / abandoned upload cleanup
CRON_SECRET=
